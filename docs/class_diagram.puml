@startuml
title Products API - Class Diagram

class Pizza {
  +int id
  +string name
  +string description
  +string imageUrl
  +float price
  +string created_at
  +string updated_at
  +static create(obj) : Promise<Product>
  +static findAll() : Promise<Product[]>
  +static findById(id) : Promise<Product|null>
  +static update(id, obj) : Promise<Product|null>
  +static delete(id) : Promise<number>
}

class PizzaController {
  +create(req, res)
  +findAll(req, res)
  +findOne(req, res)
  +update(req, res)
  +delete(req, res)
}

class Router {
  +GET /api/pizzas
  +POST /api/pizzas
  +GET /api/pizzas/:id
  +PUT /api/pizzas/:id
  +DELETE /api/pizzas/:id
}

PizzaController -- Pizza : uses >
Router --> PizzaController : routes to >

@enduml
